# Public API origin only. Never put secrets in VITE_* variables.
# This is the FULL axios baseURL — backend origin PLUS the "/api" path, no
# trailing slash. Vite inlines it at BUILD time, so a change needs a redeploy.
#   production: https://aptushire-backend-production.up.railway.app/api
VITE_API_URL=http://localhost:9000/api
# Fallback used only if an older backend response has no publicUrl. In Vercel
# Production, set this to the custom candidate-site origin with no path.
VITE_CANDIDATE_PORTAL_URL=http://localhost:5174
